{
  "responses": {
    "200": {
      "description": "List of checkpoints",
      "content": {
        "application/json": {
          "schema": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": { "type": "string" },
                "sessionId": { "type": "string" },
                "frameIndex": { "type": "integer" },
                "name": { "type": "string" },
                "notes": { "type": "string" },
                "createdAt": { "type": "string", "format": "date-time" },
                "fileCount": { "type": "integer" }
              },
              "title": "Checkpoint"
            }
          }
        }
      }
    }
  }
}
